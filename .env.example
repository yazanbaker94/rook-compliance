# Public web address of the Node API
NEXT_PUBLIC_API_URL=https://swoop.video

# Android Emulator reaches the host through 10.0.2.2.
# A physical phone needs the computer's LAN IP or your HTTPS VPS domain.
EXPO_PUBLIC_API_URL=https://swoop.video

PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Required by Docker Compose. Generate a long random value; never commit the
# populated .env file.
POSTGRES_PASSWORD=replace-with-a-random-secret
